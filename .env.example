# traycer2openai — copy to .env and edit

# --- server ---------------------------------------------------------------
# Address the proxy listens on. Keep 127.0.0.1 unless you put it behind a reverse proxy.
BIND=127.0.0.1
PORT=8787

# The API key your OpenAI-compatible client sends as `Authorization: Bearer ...`
# and the password for the dashboard. Change it.
LOGIN_TOKEN=change-me

# Require that key on /v1/*. Set to false to let local tools call the API with no
# key at all (the dashboard still asks for LOGIN_TOKEN). Any value works as an
# api_key in clients, since it is not checked.
API_AUTH=true

# --- storage --------------------------------------------------------------
# Accounts (refresh tokens) live here. Created on first add, chmod 600.
ACCOUNTS_FILE=./accounts.json

# --- upstream -------------------------------------------------------------
TRAYCER_SERVER=https://server.traycer.ai
TRAYCER_AUTHN=https://authn.traycer.ai

# How long the /v1/models catalog is cached, in seconds.
MODELS_CACHE_SECONDS=300

# --- credits dashboard ------------------------------------------------------
# How long the per-account billing snapshot (credit campaigns + totals) is
# cached, in seconds. The dashboard polls /api/state every 2 s; this bounds how
# often the proxy calls authn.traycer.ai for credits.
CREDITS_CACHE_SECONDS=30

# Auto-rotate the active account when its promotional (campaign) credits drop
# below AUTO_ROTATE_THRESHOLD dollars: the active account switches to whichever
# other healthy account has the most promo credits remaining.
AUTO_ROTATE=true
AUTO_ROTATE_THRESHOLD=5

# How often the rotation check runs, in seconds.
ROTATE_CHECK_SECONDS=30

# --- requests log ---------------------------------------------------------
# Ring buffer size for the dashboard request table. 0 disables logging.
REQUEST_LOG_SIZE=200

# Log one line per proxied request to stdout.
LOG_REQUESTS=true

# --- defaults -------------------------------------------------------------
# Account used when the client does not send X-Traycer-Account. Empty = first healthy account.
# DEFAULT_ACCOUNT=

# Used when a request omits `model`. Cheapest model in Traycer's catalog is the
# Gemini flash tier, so that is the safe default while testing.
# Other cheap options: gemini-3.8-flash (flash), claude-sonnet-5-5, deepseek-v4-flash.
DEFAULT_MODEL=gemini-3.8-flash

# Upstream request timeout in seconds (non-streaming calls and idle gaps).
UPSTREAM_TIMEOUT_SECONDS=600
